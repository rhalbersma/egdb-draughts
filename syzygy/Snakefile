# Syzygy style builds for 6x6 international draughts (syzygy.cpp), two-sided: one of each pair of a material and its
# colour mirror (the 82 materials up to 6 pieces of strongly_solving_6x6/materials), built in the order of the DAG of
# captures and promotions. A material is named wp-bp-wm-bm (white pieces, black pieces, white men, black men, two
# digits each); inside, a tuple (wm, wk, bm, bk) with kings. Per material four files of full results,
# 6x6-wp-bp-wm-bm.<side to move>.<kind>: wtm.<metric>, btm.<metric> (one byte per slot) and wtm.wdl, btm.wdl (two bits
# per slot). The depth bytes are unsigned: their signs are in the wdl files. A dtm build reads wtm.dtm and btm.dtm of
# the materials it leads into, with their wdl files; a dtc or dtz build only their wdl
# files (every move out of a material is a goal move there). The files of a metric go into <dir>/<metric>: the wdl
# files are the same for all three.
#
# Memory (synthesis 7.3): the engine's `plan` gives every material's need; each build claims it, or the whole budget if
# it does not fit (syzygy has only rung 0, so it then runs over its claim and says so). Pass the budget as
# --resources mem_mb=N (else config mem_mb, else 75 % of physical memory). Priorities follow the critical path.
#
# usage (from the root of the repo):
#   snakemake -s syzygy/Snakefile --cores 4 --config engine=build/syzygy dir=data/syzygy pieces=6 metric=dtz
# metric: dtm, dtc or dtz; policy=par runs each build in parallel (std::execution::par); rounds=scan finds the frontier
# by full scans as rtbgen (default: frontier bit planes)

ENGINE = config.get('engine', 'build/syzygy')
BASE = config.get('dir', 'data/syzygy')
N = int(config.get('pieces', 6))
METRIC = config.get('metric', 'dtm')
D = f'{BASE}/{METRIC}'
POLICY = config.get('policy', 'seq')
ROUNDS = config.get('rounds', 'frontier')
THREADS = int(config.get('threads', 4))


def stored(m):
    wm, wk, bm, bk = m
    return not (bm, wm, bk, wk) < (wm, bm, wk, bk)


def canonical(m):
    wm, wk, bm, bk = m
    return m if stored(m) else (bm, bk, wm, wk)


MATERIALS = [(wm, wk, bm, bk)
             for wm in range(N + 1) for wk in range(N + 1 - wm) for bm in range(N + 1 - wm - wk)
             for bk in range(N + 1 - wm - wk - bm)
             if wm + wk > 0 and bm + bk > 0 and stored((wm, wk, bm, bk))]


def name(m):                                                           # (wm, wk, bm, bk) -> wp-bp-wm-bm
    wm, wk, bm, bk = m
    return f'{wm + wk:02}-{bm + bk:02}-{wm:02}-{bm:02}'


def parse(n):                                                          # wp-bp-wm-bm -> (wm, wk, bm, bk)
    wp, bp, wm, bm = map(int, n.split('-'))
    return (wm, wp - wm, bm, bp - bm)


def deps(m):
    wm, wk, bm, bk = m
    out = set()
    if wm > 0: out.add((wm - 1, wk + 1, bm, bk))                       # promotions
    if bm > 0: out.add((wm, wk, bm - 1, bk + 1))
    for i in range(bm + 1):                                            # White captures i men and j kings
        for j in range(bk + 1):
            if 0 < i + j < bm + bk:
                out.add((wm, wk, bm - i, bk - j))
                if wm > 0: out.add((wm - 1, wk + 1, bm - i, bk - j))
    for i in range(wm + 1):                                            # Black captures i men and j kings
        for j in range(wk + 1):
            if 0 < i + j < wm + wk:
                out.add((wm - i, wk - j, bm, bk))
                if bm > 0: out.add((wm - i, wk - j, bm - 1, bk + 1))
    return sorted({canonical(d) for d in out} - {m})


def files(m):
    return [f'{D}/6x6-{m}.{k}' for k in (f'wtm.{METRIC}', f'btm.{METRIC}', 'wtm.wdl', 'btm.wdl')]


def inputs(m):
    kinds = ('wtm.dtm', 'btm.dtm', 'wtm.wdl', 'btm.wdl') if METRIC == 'dtm' else ('wtm.wdl', 'btm.wdl')
    return [f'{D}/6x6-{name(d)}.{k}' for d in deps(m) for k in kinds]


# the plan (src/snakemake_plan.py): memory budget, per-job claims from the engine's estimates, critical-path priorities
import os
import sys
sys.path.insert(0, os.path.join(workflow.basedir, '..', 'src'))
from snakemake_plan import memory_budget_mb, load_plan, claim_mb, priorities, report  # noqa: E402

MEM = memory_budget_mb(workflow, config)
PLAN = load_plan([ENGINE, 'plan', str(N), METRIC])
PRIO = priorities(PLAN, {name(m): [name(d) for d in deps(m)] for m in MATERIALS})
print(report(PLAN, MEM, lambda p: claim_mb(p, MEM)), file=sys.stderr)


wildcard_constraints:
    mat=r'\d\d-\d\d-\d\d-\d\d'


rule all:
    input: f'{D}/check-{N}.{METRIC}.ok'


# one build rule per material: Snakemake (8.30) accepts only constant priorities, so each material gets its own rule
# with its claim and its critical-path priority
for _m in MATERIALS:
    _n = name(_m)
    rule:
        name: f'build_{_n}'
        input: inputs(_m)
        output: files(_n)
        log: f'{D}/6x6-{_n}.{METRIC}.log'
        params: m=_n.replace('-', ' ')
        resources: mem_mb=claim_mb(PLAN[_n], MEM)
        priority: PRIO[_n]
        shell: '{ENGINE} build {D} {params.m} {METRIC} {POLICY} {ROUNDS} mem={resources.mem_mb} > {log} 2>&1'


rule check:
    input: [f for m in MATERIALS for f in files(name(m))]
    output: f'{D}/check-{N}.{METRIC}.ok'
    log: f'{D}/check-{N}.{METRIC}.log'
    threads: THREADS
    shell: '{ENGINE} checkall {D} {N} {METRIC} {threads} > {log} 2>&1 && touch {output}'
