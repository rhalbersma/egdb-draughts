# Thompson-style runs of n pieces for 6x6 international draughts (thompson86.cpp), built in the order of the
# promotion DAG: a run (WM white men, WK white kings, BM black men, BK black kings) needs the run where a white man
# has become a king (WM - 1, WK + 1) and the run where a black man has (BM - 1, BK + 1). Captures stay inside a run
# (graveyard squares), so they add no edges. Every run of n pieces is built; the runs with fewer pieces are not
# needed, because each lies inside a run of n pieces.
#
# usage (from the root of the repo):
#   snakemake -s thompson86/Snakefile --cores 4 --config engine=build/thompson86 dir=data/thompson86 pieces=6

ENGINE = config.get('engine', 'build/thompson86')
D = config.get('dir', 'data/thompson86')
N = int(config.get('pieces', 6))
THREADS = int(config.get('threads', 4))

RUNS = [(wm, wk, bm, N - wm - wk - bm)
        for wm in range(N + 1) for wk in range(N + 1 - wm) for bm in range(N + 1 - wm - wk)
        if wm + wk > 0 and N - wm - wk > 0]


def name(c):
    return '-'.join(map(str, c))


def deps(c):
    wm, wk, bm, bk = c
    out = []
    if wm > 0: out.append((wm - 1, wk + 1, bm, bk))
    if bm > 0: out.append((wm, wk, bm - 1, bk + 1))
    return out


wildcard_constraints:
    run=r'\d+-\d+-\d+-\d+'


rule all:
    input: f'{D}/check-{N}.ok'


rule build:
    input: lambda w: [f'{D}/run-{name(d)}.res' for d in deps(tuple(map(int, w.run.split('-'))))]
    output: f'{D}/run-{{run}}.res'
    log: f'{D}/run-{{run}}.log'
    params: caps=lambda w: w.run.replace('-', ' ')
    shell: '{ENGINE} build {D} {params.caps} > {log} 2>&1'


rule check:
    input: [f'{D}/run-{name(c)}.res' for c in RUNS]
    output: f'{D}/check-{N}.ok'
    log: f'{D}/check-{N}.log'
    threads: THREADS
    shell: '{ENGINE} checkall {D} {N} {threads} > {log} 2>&1 && touch {output}'
