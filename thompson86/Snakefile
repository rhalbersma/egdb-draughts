# Thompson style builds for 6x6 international draughts (thompson86.cpp), one file per material, built in the order
# of the DAG of captures and promotions. A material is named wp-bp-wm-bm (white pieces, black pieces, white men, black
# men, two digits each, as in egdb_6x6's material mode); inside, a tuple (wm, wk, bm, bk) with kings. A material needs
# every material one move can lead into: a promotion (a man of either side becomes a king), a capture of one or more
# pieces of either side (the capturing man possibly promoting). A capture of a side's last piece ends the game and
# needs no file. Every material with at most n pieces and a piece on each side is built, into two files: .w (White to
# move, plies to a White win) and .l (Black to move, 1 + plies to Black's loss).
#
# usage (from the root of the repo):
#   snakemake -s thompson86/Snakefile --cores 4 --config engine=build/thompson86 dir=data/thompson86 pieces=6 \
#       metric=dtm style=86
# metric: dtm, dtc or dtz; style: 86 (one slice at a time) or 96 (waves, masked passes)

ENGINE = config.get('engine', 'build/thompson86')
D = config.get('dir', 'data/thompson86')
N = int(config.get('pieces', 6))
METRIC = config.get('metric', 'dtm')
STYLE = str(config.get('style', '86'))
THREADS = int(config.get('threads', 4))

MATERIALS = [(wm, wk, bm, bk)
             for wm in range(N + 1) for wk in range(N + 1 - wm) for bm in range(N + 1 - wm - wk)
             for bk in range(N + 1 - wm - wk - bm)
             if wm + wk > 0 and bm + bk > 0]


def name(m):                                                           # (wm, wk, bm, bk) -> wp-bp-wm-bm
    wm, wk, bm, bk = m
    return f'{wm + wk:02}-{bm + bk:02}-{wm:02}-{bm:02}'


def parse(n):                                                          # wp-bp-wm-bm -> (wm, wk, bm, bk)
    wp, bp, wm, bm = map(int, n.split('-'))
    return (wm, wp - wm, bm, bp - bm)


def deps(m):
    wm, wk, bm, bk = m
    out = set()
    if wm > 0: out.add((wm - 1, wk + 1, bm, bk))                       # promotions
    if bm > 0: out.add((wm, wk, bm - 1, bk + 1))
    for i in range(bm + 1):                                            # White captures i men and j kings
        for j in range(bk + 1):
            if 0 < i + j < bm + bk:
                out.add((wm, wk, bm - i, bk - j))
                if wm > 0: out.add((wm - 1, wk + 1, bm - i, bk - j))
    for i in range(wm + 1):                                            # Black captures i men and j kings
        for j in range(wk + 1):
            if 0 < i + j < wm + wk:
                out.add((wm - i, wk - j, bm, bk))
                if bm > 0: out.add((wm - i, wk - j, bm - 1, bk + 1))
    return sorted(out)


wildcard_constraints:
    mat=r'\d\d-\d\d-\d\d-\d\d'


rule all:
    input: f'{D}/check-{N}.{METRIC}.ok'


def files(m):
    return [f'{D}/6x6-{m}.{METRIC}.w', f'{D}/6x6-{m}.{METRIC}.l']


rule build:
    input: lambda w: [f for d in deps(parse(w.mat)) for f in files(name(d))]
    output: files('{mat}')
    log: f'{D}/6x6-{{mat}}.{METRIC}.log'
    params: m=lambda w: w.mat.replace('-', ' ')
    shell: '{ENGINE} build {D} {params.m} {METRIC} {STYLE} > {log} 2>&1'


rule check:
    input: [f for m in MATERIALS for f in files(name(m))]
    output: f'{D}/check-{N}.{METRIC}.ok'
    log: f'{D}/check-{N}.{METRIC}.log'
    threads: THREADS
    shell: '{ENGINE} checkall {D} {N} {METRIC} {threads} > {log} 2>&1 && touch {output}'
